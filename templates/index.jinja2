{% extends "_base.jinja2" %}

{% block nav_title %}SISTEMA ESCOLAR{% endblock %}
{% block title %}Sistema Escolar - Início{% endblock %}

{% block content %}

<div class="inicio">

    <h1>Gestão da Escola</h1>

    <p>Bem-vindo ao Sistema Escolar</p>

    <div class="info-box">

        <div class="usuario">

            <div class="usuario-info">

                <h2>Informações do usuário</h2>

                <p>
                    <strong>Nome:</strong>
                    {{ usuario.nome }}
                </p>

                <p>
                    <strong>Usuário:</strong>
                    {{ usuario.usuario }}
                </p>

                <p>
                    <strong>Perfil:</strong>
                    {{ usuario.perfil }}
                </p>

            </div>

            <div class="usuario-foto">

                <img
                    src="{{ url_for('static', filename='img/' + usuario.foto) }}"
                    alt="Foto do usuário">

            </div>

        </div>

    </div>

    <div class="info-box">

        <h2>Dados da escola</h2>

        <p>
            <strong>Período letivo:</strong> 2026
        </p>

        <p>
            <strong>Situação:</strong> Em andamento
        </p>

    </div>

    <div class="info-box">

        <h2>Calendário escolar vigente</h2>

        <p>1º Período: 09/02/2026 a 18/05/2026</p>
        <p>2º Período: 18/05/2026 a 28/08/2026</p>
        <p>3º Período: 31/08/2026 a 18/12/2026</p>

    </div>

</div>

{% endblock %}