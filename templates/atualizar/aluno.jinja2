<!-- atualizar/aluno.jinja2 -->

{% extends "_base.jinja2" %}

{% block nav_title %}SISTEMA ESCOLAR{% endblock %}
{% block title %}Atualizar Aluno{% endblock %}

{% block content %}

<h2 class="text-center" style="margin-bottom: 20px;">
    Atualizar Aluno
</h2>

<form class="text-center" action="{{ api }}" method="post">
    <!-- Renderize os campos de entrada usando os macros (veja arquivo templates/_macros.jinja2) -->

    {{ macros.render_input("", "hidden", "id_aluno", id_aluno) }}

    {{ macros.render_input("Nome:", "text", "nome", nome) }}

    {{ macros.render_input("Data de Nascimento:", "date", "data_nascimento", data_nascimento) }}

    {{ macros.render_input("Endereco:", "text", "endereco", endereco) }}

    {{ macros.render_input("Data de Matricula:", "date", "data_matricula", data_matricula) }}

    <button type="submit" class="btn btn-primary">Atualizar</button>
</form>

{% endblock %}
