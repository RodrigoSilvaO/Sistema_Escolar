<!-- atualizar/avaliacao.jinja2 -->

{% extends "_base.jinja2" %}

{% block nav_title %}SISTEMA ESCOLAR{% endblock %}
{% block title %}Atualizar Avaliacao{% endblock %}

{% block content %}

<h2 class="text-center" style="margin-bottom: 20px;">
    Atualizar Avaliacao
</h2>

<form class="text-center" action="{{ api }}" method="post">
    <!-- Renderize os campos de entrada usando os macros (veja arquivo templates/_macros.jinja2) -->

    {{ macros.render_input("", "hidden", "id_boletim", id_boletim) }}

    {{ macros.render_select("Aluno:", "id_aluno", alunos, id_aluno) }}

    {{ macros.render_select("Disciplina:", "id_disciplina", disciplinas, id_disciplina) }}

    {{ macros.render_input("Numero da Avaliacao:", "number", "numero_avaliacao", numero_avaliacao) }}

    {{ macros.render_input("Nota:", "number", "nota", nota) }}

    {{ macros.render_input("Data da Avaliacao:", "date", "data_avaliacao", data_avaliacao) }}

    {{ macros.render_input("Observacao:", "text", "observacao", observacao) }}

    <button type="submit" class="btn btn-primary">Atualizar</button>
</form>

{% endblock %}
