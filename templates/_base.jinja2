```html
{% import "_macros.jinja2" as macros %}

<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}TITLE{% endblock %}</title>
    <link rel="stylesheet" href="{{ url_for('static', filename='bootstrap.min.css') }}">
    <link rel="stylesheet" href="{{ url_for('static', filename='index.css') }}">
    <script src="{{ url_for('static', filename='bootstrap.bundle.min.js') }}" defer></script>
</head>

<body>

    <nav class="navbar navbar-expand-lg bg-dark border-bottom border-secondary mb-4"
        data-bs-theme="dark">

        <div class="container">

            <!-- Nome do sistema -->
            <a class="navbar-brand fw-bold me-4" href="{{ url_for('home') }}">
                {% block nav_title %}{% endblock %}
            </a>

            <!-- Botão mobile -->
            <button class="navbar-toggler" type="button"
                data-bs-toggle="collapse"
                data-bs-target="#navbarNavDropdown"
                aria-controls="navbarNavDropdown"
                aria-expanded="false"
                aria-label="Abrir menu">

                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- Menus -->
            <div class="collapse navbar-collapse" id="navbarNavDropdown">

                <ul class="navbar-nav align-items-lg-center gap-lg-1">

                    <li class="nav-item">
                        <a class="nav-link px-3" href="{{ url_for('home') }}">
                            Home
                        </a>
                    </li>

                    {{ macros.render_nav_dropdown("Consultar", {
                    "/consultar/aluno" : "Aluno",
                    "/consultar/professor" : "Professor",
                    "/consultar/especialidade_professor" : "Especialidade do Professor",
                    "/consultar/disciplina" : "Disciplina",
                    "/consultar/disciplina_professor" : "Disciplina x Professor",
                    "/consultar/periodo_letivo" : "Período Letivo",
                    "/consultar/periodo_ferias" : "Período de Férias",
                    "/consultar/turma" : "Turma",
                    "/consultar/turma_disciplina" : "Turma x Disciplina",
                    "/consultar/matricula_disciplina" : "Matrícula em Disciplina",
                    "/consultar/avaliacao" : "Avaliação",
                    "/consultar/registro_frequencia" : "Registro de Frequência",
                    "/consultar/resultado_final" : "Resultado Final",
                    }) }}

                    {{ macros.render_nav_dropdown("Cadastrar", {
                    "/cadastrar/aluno" : "Aluno",
                    "/cadastrar/professor" : "Professor",
                    "/cadastrar/especialidade_professor" : "Especialidade do Professor",
                    "/cadastrar/disciplina" : "Disciplina",
                    "/cadastrar/disciplina_professor" : "Disciplina x Professor",
                    "/cadastrar/periodo_letivo" : "Período Letivo",
                    "/cadastrar/periodo_ferias" : "Período de Férias",
                    "/cadastrar/turma" : "Turma",
                    "/cadastrar/turma_disciplina" : "Turma x Disciplina",
                    "/cadastrar/matricula_disciplina" : "Matrícula em Disciplina",
                    "/cadastrar/avaliacao" : "Avaliação",
                    "/cadastrar/registro_frequencia" : "Registro de Frequência",
                    "/cadastrar/resultado_final" : "Resultado Final",
                    }) }}
                    <li class="nav-item">
                        <a class="nav-link px-3" href="{{ url_for('logout') }}">
                            Sair
                        </a>
                    </li>

                </ul>

            </div>
        </div>
    </nav>

    <main class="container pb-5">
        {% block content %}{% endblock %}
    </main>

</body>

</html>
```
